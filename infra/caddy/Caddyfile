# GnomeVPN — Caddy config (runs on the VPS).
#
# Certificates come from Let's Encrypt over HTTP-01, so behind Cloudflare the
# orange cloud stays off until they exist, then SSL mode must be Full (strict)
# or the two redirect each other in a loop.
#
# A ClientHello without SNI, or with a name no site here holds, gets the API's
# certificate rather than a bare TLS internal_error alert, which is all a
# client logs and says nothing about which host it asked for.

{
	default_sni api.gnome-vpn.com
	fallback_sni api.gnome-vpn.com
}

(proxy_headers) {
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
}

# The access log keeps no full client address and no credential: IPs are cut
# to /16 (IPv4) and /32 (IPv6), the query parameters that carry one-time codes
# and tokens are dropped, and so are the headers that carry sessions or the
# webhook secret. Paths that would build a per-account IP history are not
# logged at all (log_skip, Caddy 2.8+). docs/architecture/logging.md.
(access_log) {
	log {
		output stdout
		format filter {
			wrap console
			fields {
				request>remote_ip ip_mask {
					ipv4 16
					ipv6 32
				}
				request>client_ip ip_mask {
					ipv4 16
					ipv6 32
				}
				request>uri query {
					delete token
					delete code
					delete ref
				}
				request>headers>Authorization delete
				request>headers>Cookie delete
				request>headers>X-Telegram-Bot-Api-Secret-Token delete
				resp_headers>Set-Cookie delete
				resp_headers>Set-Auth-Token delete
			}
		}
	}
}

# The project lived on gnomevpn.ru first, and every subscription link imported
# before the move still names api.gnomevpn.ru. Those keep working: the API
# answers on both names, and the old site redirects.
www.gnome-vpn.com, gnomevpn.ru, www.gnomevpn.ru {
	redir https://gnome-vpn.com{uri} permanent
}

api.gnome-vpn.com, api.gnomevpn.ru {
	# Every INCY refresh fetches the feed and the geo files: logging them would
	# record each subscriber's address over time, and the feed path is the token.
	@unlogged path /sub/* /routing/geo/* /auth/reset-password/*
	log_skip @unlogged

	encode gzip zstd

	reverse_proxy server:4000

	import access_log
}

# Callback host for Telegram, proxied through Cloudflare: our own IPv4 is blocked.
bot.gnome-vpn.com {
	# route keeps source order; without it Caddy sorts respond ahead of the proxy.
	route {
		reverse_proxy /telegram/* server:4000
		respond 404
	}

	import access_log
}

gnome-vpn.com {
	encode gzip zstd

	reverse_proxy web:3000

	# Hashed assets never change under the same name.
	@immutable path /_next/static/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	import proxy_headers
	import access_log
}
