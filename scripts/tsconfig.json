{
  "extends": "@siberiacancode/tsconfig/tsconfig.bundler.json",
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "types": ["bun"],
    "noEmit": true,
    "paths": {
      "@/generated": ["../apps/server/generated"],
      "@/*": ["../apps/server/src/*"]
    }
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules"]
}
