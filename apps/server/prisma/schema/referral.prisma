enum ReferralSource {
  web
  telegram
}

model ReferralCode {
  userId String @id @map("user_id")
  code   String @unique

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("referral_code")
}

model Referral {
  id         String @id @default(dbgenerated("gen_random_uuid()"))
  referrerId String @map("referrer_id")
  referredId String @unique @map("referred_id")

  source ReferralSource

  paymentId    String?   @unique @map("payment_id")
  referrerDays Int       @default(0) @map("referrer_days")
  friendDays   Int       @default(0) @map("friend_days")
  rewardedAt   DateTime? @map("rewarded_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  referrer User     @relation("ReferralsMade", fields: [referrerId], references: [id], onDelete: Cascade)
  referred User     @relation("ReferredBy", fields: [referredId], references: [id], onDelete: Cascade)
  payment  Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([referrerId, rewardedAt])
  @@map("referral")
}
