model TelegramAccount {
  id String @id @default(dbgenerated("gen_random_uuid()"))

  userId String @unique @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  telegramId BigInt  @unique @map("telegram_id")
  username   String?

  languageCode String? @map("language_code")
  locale       String?

  linkedAt   DateTime  @default(now()) @map("linked_at") @db.Timestamptz(3)
  lastSeenAt DateTime? @map("last_seen_at") @db.Timestamptz(3)
  blockedAt  DateTime? @map("blocked_at") @db.Timestamptz(3)

  @@map("telegram_account")
}

model TelegramLinkCode {
  code String @id

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([userId])
  @@index([expiresAt])
  @@map("telegram_link_code")
}

model TelegramWebLogin {
  code String @id

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([userId])
  @@index([expiresAt])
  @@map("telegram_web_login")
}

model TelegramSupportMessage {
  adminChatId    BigInt @map("admin_chat_id")
  adminMessageId Int    @map("admin_message_id")

  telegramId BigInt  @map("telegram_id")
  locale     String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@id([adminChatId, adminMessageId])
  @@index([createdAt])
  @@map("telegram_support_message")
}
