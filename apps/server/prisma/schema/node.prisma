model Node {
  id String @id @default(dbgenerated("gen_random_uuid()"))

  country     String
  countryCode String  @unique @map("country_code")
  city        String?

  host String @unique
  port Int    @default(443)

  serverName String @map("server_name")

  certFingerprint String? @map("cert_fingerprint")

  realityPublicKey String? @map("reality_public_key")
  realityShortId   String? @map("reality_short_id")

  wgPublicKey String? @map("wg_public_key")

  relayHost String? @map("relay_host")
  relayPort Int?    @map("relay_port")

  relayWireguardPort Int? @map("relay_wireguard_port")

  relayHealthyAt DateTime? @map("relay_healthy_at") @db.Timestamptz(3)

  apiUrl         String @map("api_url")
  apiTokenEnvVar String @map("api_token_env_var")

  isAvailable  Boolean @default(true) @map("is_available")
  displayOrder Int     @default(0) @map("display_order")

  lastHealthyAt DateTime? @map("last_healthy_at") @db.Timestamptz(3)
  lastCheckedAt DateTime? @map("last_checked_at") @db.Timestamptz(3)
  isOverloaded  Boolean   @default(false) @map("is_overloaded")
  packetLoss    Int?      @map("packet_loss")

  bootedAt      DateTime? @map("booted_at") @db.Timestamptz(3)
  coreStartedAt DateTime? @map("core_started_at") @db.Timestamptz(3)

  onlineClients Int? @map("online_clients")
  onlineUsers   Int? @map("online_users")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  peers  Peer[]
  uptime NodeUptime[]
  peaks  NodePeak[]
  probes NodeProbe[]

  @@map("node")
}
