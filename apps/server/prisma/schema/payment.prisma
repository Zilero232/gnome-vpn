enum PaymentStatus {
  pending
  succeeded
  canceled
  refunded
}

enum PaymentKind {
  subscription
  extraDevices
  gift
}

model Payment {
  id                String  @id @default(dbgenerated("gen_random_uuid()"))
  userId            String? @map("user_id")
  yookassaPaymentId String  @unique @map("yookassa_payment_id")

  amount       Decimal           @map("amount") @db.Decimal(10, 2)
  status       PaymentStatus     @default(pending)
  plan         SubscriptionPlan?
  isAutoCharge Boolean           @default(false) @map("is_auto_charge")

  paymentMethodId String? @map("payment_method_id")

  kind         PaymentKind @default(subscription)
  extraDevices Int         @default(0) @map("extra_devices")

  promoCodeId     String? @map("promo_code_id")
  discountPercent Int?    @map("discount_percent")

  refundRequestedAt DateTime? @map("refund_requested_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user               User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  referral           Referral?
  promoCode          PromoCode?       @relation("DiscountedPayments", fields: [promoCodeId], references: [id], onDelete: SetNull)
  gift               PromoCode?       @relation("GiftPayment")
  consumedRedemption PromoRedemption? @relation("ConsumedDiscount")

  @@index([userId, isAutoCharge, status, createdAt])
  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([promoCodeId])
  @@map("payment")
}
