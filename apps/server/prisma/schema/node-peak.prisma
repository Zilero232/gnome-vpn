model NodePeak {
  nodeId String   @map("node_id")
  day    DateTime @db.Date

  clients   Int?
  clientsAt DateTime? @map("clients_at") @db.Timestamptz(3)
  users     Int?

  cpu    Float?
  memory Float?

  node Node @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@id([nodeId, day])
  @@index([day])
  @@map("node_peak")
}
