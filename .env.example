
# Copy to .env at the repo root.

NODE_ENV=development
PORT=4000

# --- Client ---

# Baked into the bundle and visible to users. No secrets.
NEXT_PUBLIC_API_URL=http://localhost:4000
CLIENT_URL=http://localhost:3000

# Seller requisites on /terms, all optional. An empty name hides the section.
# STATUS is entrepreneur or selfEmployed; INN 12 digits; OGRNIP 15 digits.
NEXT_PUBLIC_SELLER_NAME=
NEXT_PUBLIC_SELLER_STATUS=
NEXT_PUBLIC_SELLER_INN=
NEXT_PUBLIC_SELLER_OGRNIP=
NEXT_PUBLIC_SELLER_ADDRESS=

# --- Database ---

# 5433, not 5432: a native Postgres service usually holds 5432.
DATABASE_URL=postgresql://gnomevpn:gnomevpn@localhost:5433/gnomevpn
DIRECT_URL=postgresql://gnomevpn:gnomevpn@localhost:5433/gnomevpn

# --- Auth ---

# 32+ chars: openssl rand -base64 32
BETTER_AUTH_SECRET=dev-secret-change-me-min-32-chars-000
API_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:3000

# --- Payments ---

YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_RETURN_URL=http://localhost:3000/account
# Enabled by YooKassa support on request. False means one-off payments.
YOOKASSA_RECURRING=false

# --- Mail ---

# Empty sends nothing; sign-up still works. EMAIL_FROM must match SMTP_USER.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=GnomeVPN <noreply@example.com>
# DEV_EMAIL_OVERRIDE=you@example.com

# --- Telegram bot ---

# An empty token switches the bot off.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
# Callback host for the webhook, proxied through Cloudflare. Empty registers none.
TELEGRAM_WEBHOOK_URL=
# The owner's support and admin chat (send /chatid there to learn it). Empty
# switches off the support desk, /stats, /broadcast and the alerts.
TELEGRAM_ADMIN_CHAT_ID=

# --- Support ---

SUPPORT_URL=

# --- Admin panel ---

# Comma-separated emails that may open /admin on the site; case does not
# matter. The account must also have confirmed that email. Empty: no admins,
# every /admin route answers 404.
ADMIN_EMAILS=

# --- Provisioning ---

# Empty HOST runs provisioning locally. Deploy uses DEPLOY_SSH_* instead.
PROVISION_SSH_HOST=
PROVISION_SSH_USER=root
PROVISION_SSH_PASSWORD=
PROVISION_DEPLOY_PATH=/opt/gnomevpn
